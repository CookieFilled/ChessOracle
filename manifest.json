{
  "manifest_version": 3,
  "name": "ChessOracle \u2014 Live Engine Assistant & Elo Bot",
  "version": "1.2.1",
  "description": "Real-time Stockfish analysis, move suggestions, eval bar, elo-matched autoplay and hands-free autopilot sessions for chess.com and lichess.",
  "author": "ChessOracle",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChessOracle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://www.chess.com/*"
      ],
      "js": [
        "inject/main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://lichess.org/*",
        "https://www.chess.com/*"
      ],
      "js": [
        "lib/chess.js",
        "lib/protocol.js",
        "lib/settings.js",
        "content/sites.js",
        "content/move-diff.js",
        "content/adapter.js",
        "content/game-state.js",
        "content/analyzer.js",
        "content/selection.js",
        "content/book.js",
        "content/input.js",
        "content/overlays.js",
        "content/auto-player.js",
        "content/autopilot.js",
        "content/panel-styles.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}